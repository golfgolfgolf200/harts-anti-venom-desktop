{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "harts-anti-venom",
  "version": "1.0.0",
  "identifier": "com.hartsantivenom.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Hart's Anti-Venom Guard",
